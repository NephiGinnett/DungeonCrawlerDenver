# ---------------------------------------------------------------------------
# Unreal Engine generated / derived directories.
# All of these are rebuilt from source and must never be committed.
# ---------------------------------------------------------------------------
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/
Platforms/*/Binaries/
Platforms/*/Intermediate/

# Visual Studio / Rider / VS Code project files, all regenerated from the .uproject
.vs/
.idea/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# ---------------------------------------------------------------------------
# Content: allow-list, not deny-list.
#
# Content/ is ~27GB, almost entirely Fab marketplace packs. Those are licensed
# to Zoe's Epic account and are not ours to redistribute - and several single
# files exceed GitHub's hard 100MB limit anyway. So everything under Content/ is
# ignored by default and our own folders are re-included explicitly.
#
# Written this way round on purpose: a deny-list would silently start committing
# the next Fab pack that gets downloaded. This way new packs are ignored by
# default and adding OUR content is a deliberate act.
#
# A fresh clone therefore needs the Fab packs re-downloaded from Epic before
# Lvl_ThirdPerson will render fully. That is expected.
# ---------------------------------------------------------------------------
/Content/*
!/Content/DCC/
!/Content/ThirdPerson/
!/Content/Characters/
!/Content/Input/
!/Content/LevelPrototyping/
!/Content/Variant_Combat/
!/Content/Collections/
!/Content/__ExternalActors__/
!/Content/__ExternalObjects__/

# ---------------------------------------------------------------------------
# Source art: keep the originals, drop anything regenerated from them.
# The per-animation FBX files are Blender output and can be rebuilt at any time
# from the .glb originals (see CLAUDE.md, "Importing character models").
# ---------------------------------------------------------------------------
/SourceArt/**/fbx/

# OS noise
Thumbs.db
desktop.ini
.DS_Store

# Python bytecode from the Tools/ helper scripts
__pycache__/
*.pyc

# Marketplace/Fab code plugins: same reasoning as Content packs above -
# licensed to Zoe's Epic account, re-download from Fab on a fresh clone.
/Plugins/Marketplace/

# Fab sample heroes copied into Characters/ on 2026-11-25. They blow past GitHub's
# 100MB file limit, and they stay licensed to the Epic account.
/Content/Characters/Echo/
/Content/Characters/Paragon/
/Content/Characters/UE4_Mannequin/
/Content/Characters/UE5_Mannequins/
/Content/Characters/UEFN_Mannequin/

# World Partition data for those copied sample maps. The maps themselves stay
# ignored with the rest of Content/.
/Content/__ExternalActors__/DerelictCorridor/
/Content/__ExternalActors__/FirstPerson/
/Content/__ExternalActors__/Forest_village/
/Content/__ExternalActors__/Free_Magic/
/Content/__ExternalActors__/Free_Spells/
/Content/__ExternalActors__/Guard/
/Content/__ExternalActors__/Knife_FPS_Animations/
/Content/__ExternalActors__/Polytope_Studio/
/Content/__ExternalActors__/Sample/
/Content/__ExternalActors__/Scene_Saloon/
/Content/__ExternalActors__/StageProps/
/Content/__ExternalObjects__/DerelictCorridor/
/Content/__ExternalObjects__/Free_Magic/
/Content/__ExternalObjects__/Free_Spells/
/Content/__ExternalObjects__/Guard/
/Content/__ExternalObjects__/Knife_FPS_Animations/
/Content/__ExternalObjects__/Sample/
/Content/__ExternalObjects__/StageProps/
# Crawler Companion
Companion/node_modules/
Companion/snapshot.png
Companion/snapshot_*.png
Companion/studio_snapshot.png
Companion/dist/
Companion/release/
