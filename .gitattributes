# Unreal binary assets go through Git LFS. Without this, every edit to a .uasset
# stores a whole new copy in git history and the repository grows permanently -
# a Blueprint tweaked fifty times would carry fifty full copies forever.
*.uasset filter=lfs diff=lfs merge=lfs -text
*.umap   filter=lfs diff=lfs merge=lfs -text

# Source art and imported media
*.glb    filter=lfs diff=lfs merge=lfs -text
*.fbx    filter=lfs diff=lfs merge=lfs -text
*.png    filter=lfs diff=lfs merge=lfs -text
*.tga    filter=lfs diff=lfs merge=lfs -text
*.wav    filter=lfs diff=lfs merge=lfs -text

# Text formats: normalise line endings so diffs stay readable across machines.
*.cpp    text
*.h      text
*.cs     text
*.ini    text
*.md     text
*.uproject text eol=lf

# Large binaries that previously slipped past LFS
*.zip    filter=lfs diff=lfs merge=lfs -text
*.blend  filter=lfs diff=lfs merge=lfs -text
**/*.fbm/** filter=lfs diff=lfs merge=lfs -text